# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars itself.

db_admin_password = "change-me-to-a-strong-password"

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application; add both Static Web App URLs as Authorized JavaScript origins)
google_client_id = "xxxxxxxxxx.apps.googleusercontent.com"

# Generate with: openssl rand -base64 48
jwt_secret = "change-me-to-a-long-random-secret"

# Comma-separated Google account emails to treat as SUPER_ADMIN
super_admin_emails = "you@example.com"

apim_publisher_email = "you@example.com"

# Optional overrides (defaults shown)
# prefix               = "univolve-prod"
# location             = "Southeast Asia"
# swa_location         = "East Asia"
# acs_data_location    = "Asia Pacific"
# db_admin_username    = "univolveadmin"
# db_name              = "univolvedb"
# apim_publisher_name  = "UniVolve"
# backend_image        = "acrunivolveprod.azurecr.io/univolve-backend:latest"
